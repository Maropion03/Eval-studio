# Eval Studio v2 — backend env template
# Copy to .env.local for local dev. Never commit .env.local.

# ── LLM providers ───────────────────────────────────────────
# Server-owned key for dev / showcase. End users supply their own via BYOK Settings.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=

# ── Fixed inference roles ───────────────────────────────────
JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Pro
WRITER_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ── Database ────────────────────────────────────────────────
# Local fallback uses SQLite if blank
DATABASE_URL=

# ── App ─────────────────────────────────────────────────────
DEBUG=0
CORS_ORIGINS=http://localhost:5173,https://eval-studio.vercel.app
SESSION_COOKIE_NAME=eval_studio_sid
SESSION_TTL_SECONDS=86400
RATE_LIMIT_PER_HOUR=50
